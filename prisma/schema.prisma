generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Building {
  id           String       @id @default(cuid())
  osmId        String?
  osmType      String?
  address      String
  lat          Float
  lng          Float
  roofAreaM2   Float?
  buildingType String?
  heightMeters Float?
  hasSolar     Boolean      @default(false)
  assessment   Assessment?
  proposals    Proposal[]
  opportunity  Opportunity?
  discoveryCandidates DiscoveryCandidate[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([lat, lng])
  @@index([buildingType])
  @@index([osmId])
}

model Opportunity {
  id                    String   @id @default(cuid())
  buildingId            String   @unique
  building              Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  status                String   @default("new")
  priority              String   @default("unreviewed")
  scoreTotal            Float    @default(0)
  scoreBand             String   @default("D")
  confidence            Float    @default(0)
  nextAction            String   @default("ASSESS")
  reasonsJson           Json?
  risksJson             Json?
  lastScoredAt          DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  assignedTo            String?

  scores                OpportunityScore[]
  evidence              SolarizationEvidence[]
  notes                 OpportunityNote[]
  discoveryCandidates DiscoveryCandidate[]
  rankSnapshots        OpportunityRankSnapshot[]
  verificationTasks    VerificationTask[]
  companySignals       CompanySignal[]
  contactSignals       ContactSignal[]
  outreachActivities   OutreachActivity[]

  @@index([scoreBand, scoreTotal])
  @@index([status])
  @@index([nextAction])
}

model OpportunityScore {
  id                    String      @id @default(cuid())
  opportunityId         String
  opportunity           Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  version               String
  roofFitScore           Float
  economicsScore         Float
  buildingTypeScore      Float
  unsolarizedScore       Float
  dataCompletenessScore  Float
  regulatoryScore        Float
  totalScore             Float
  reasonsJson            Json?
  risksJson              Json?
  createdAt              DateTime    @default(now())

  @@index([opportunityId, createdAt])
}

model SolarizationEvidence {
  id             String      @id @default(cuid())
  opportunityId  String
  opportunity    Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  status         String
  source         String
  sourceUrl      String?
  confidence     Float
  notes          String?
  observedAt     DateTime?
  createdBy      String?
  createdAt      DateTime @default(now())

  @@index([opportunityId])
  @@index([status, confidence])
}

model InvestigationRun {
  id                   String   @id @default(cuid())
  name                 String?
  centerLat            Float
  centerLng            Float
  radiusMeters         Int
  status               String   @default("pending")
  buildingsFound       Int      @default(0)
  opportunitiesCreated Int      @default(0)
  error                String?
  createdBy            String?
  createdAt             DateTime @default(now())
  completedAt          DateTime?

  buildings            InvestigationRunBuilding[]

  @@index([status, createdAt])
}

model InvestigationRunBuilding {
  id                 String           @id @default(cuid())
  investigationRunId String
  investigationRun   InvestigationRun @relation(fields: [investigationRunId], references: [id], onDelete: Cascade)
  buildingId         String
  opportunityId      String?
  action             String
  createdAt          DateTime         @default(now())

  @@index([investigationRunId])
  @@index([buildingId])
}

model OpportunityNote {
  id             String      @id @default(cuid())
  opportunityId  String
  opportunity    Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  body           String
  createdBy      String?
  createdAt      DateTime @default(now())
}


model Assessment {
  id               String     @id @default(cuid())
  buildingId       String     @unique
  building         Building   @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  dataSource       String     @default("HYBRID")
  ghiAnnual        Float
  systemSizeKwp    Float
  panelCount       Int
  annualProduction Float
  totalCostAed     Float
  annualSavingsAed Float
  paybackYears     Float
  npv25yrAed       Float
  co2OffsetTons    Float
  dewaTariffAed    Float      @default(0.32)
  rawResponseJson  Json?
  proposals        Proposal[]
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  role         String    @default("user")
  emailVerified DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  accounts  Account[]
  sessions  Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Proposal {
  id           String     @id @default(cuid())
  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  buildingId   String
  building     Building   @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  pdfUrl       String?
  status       String     @default("pending")
  generatedBy  String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model DataConnector {
  id             String   @id
  name           String
  category       String
  baseUrl        String?
  license        String?
  accessModel    String   @default("unknown")
  refreshCadence String
  enabled        Boolean  @default(true)
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model ConnectorRun {
  id            String    @id @default(cuid())
  connectorId   String
  status        String
  inputJson     Json?
  outputCount   Int       @default(0)
  error         String?
  startedAt     DateTime  @default(now())
  completedAt   DateTime?

  @@index([connectorId, startedAt])
  @@index([status])
}

model ConnectorSignal {
  id            String   @id @default(cuid())
  connectorId   String
  entityType    String
  entityId      String
  buildingId    String?
  opportunityId String?
  signalType    String
  sourceName    String
  sourceUrl     String?
  license       String?
  confidence    Float
  payloadJson   Json
  observedAt    DateTime?
  fetchedAt     DateTime @default(now())

  @@index([buildingId])
  @@index([opportunityId])
  @@index([entityType, entityId])
  @@index([signalType])
  @@index([connectorId, fetchedAt])
}

model ScanCampaign {
  id              String      @id @default(cuid())
  name            String
  emirate         String?
  status          String      @default("draft") // draft, pending, running, completed, failed, paused
  boundsJson      Json?       // Bounding box or coordinates
  filtersJson     Json?       // Bounding filters (e.g. min area, building types)
  createdBy       String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  startedAt       DateTime?
  completedAt     DateTime?
  tiles           ScanTile[]
  candidates      DiscoveryCandidate[]
  rankSnapshots   OpportunityRankSnapshot[]
}

model ScanTile {
  id              String      @id @default(cuid())
  campaignId      String
  campaign        ScanCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  status          String      @default("pending") // pending, running, completed, failed
  boundsJson      Json        // Bounding box coordinates for this specific tile
  attemptCount    Int         @default(0)
  buildingsFound  Int         @default(0)
  error           String?     @db.Text
  lockedAt        DateTime?
  completedAt     DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  candidates      DiscoveryCandidate[]

  @@index([campaignId])
  @@index([status])
}

model DiscoveryCandidate {
  id              String      @id @default(cuid())
  campaignId      String?
  campaign        ScanCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  scanTileId      String?
  tile            ScanTile?     @relation(fields: [scanTileId], references: [id], onDelete: SetNull)
  buildingId      String?
  building        Building?     @relation(fields: [buildingId], references: [id], onDelete: SetNull)
  opportunityId   String?
  opportunity     Opportunity?  @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  sourceId        String      // e.g. "osm"
  sourceKey       String?     // e.g. osmId "123456"
  lat             Float
  lng             Float
  geometryJson    Json?
  payloadJson     Json?
  confidence      Float       @default(0.5)
  status          String      @default("new") // new, processed, duplicate, ignored
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([campaignId])
  @@index([scanTileId])
  @@index([buildingId])
  @@index([opportunityId])
  @@index([sourceId, sourceKey])
  @@unique([sourceId, sourceKey]) // Deduplication constraint
}

model OpportunityRankSnapshot {
  id              String   @id @default(cuid())
  opportunityId   String
  opportunity     Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  campaignId      String?
  campaign        ScanCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  scoringVersion  String
  scoreTotal      Float
  rankGlobal      Int?
  rankCampaign    Int?
  driversJson     Json?
  blockersJson    Json?
  createdAt       DateTime @default(now())

  @@index([opportunityId])
  @@index([campaignId])
}

model VerificationTask {
  id              String   @id @default(cuid())
  opportunityId   String
  opportunity     Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  providerId      String
  status          String   @default("pending") // pending, completed, failed
  priority        Int      @default(50)
  resultJson      Json?
  error           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  completedAt     DateTime?

  @@index([opportunityId])
  @@index([status])
}

model CompanySignal {
  id              String   @id @default(cuid())
  opportunityId   String
  opportunity     Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  companyName     String
  relationship    String?  // e.g. "tenant", "owner", "occupant"
  source          String   // e.g. "manual", "imported_csv", "google_places"
  sourceUrl       String?
  confidence      Float    @default(0.5)
  payloadJson     Json?
  observedAt      DateTime?
  createdAt       DateTime @default(now())
  contacts        ContactSignal[]

  @@index([opportunityId])
}

model ContactSignal {
  id              String   @id @default(cuid())
  opportunityId   String
  opportunity     Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  companySignalId String?
  companySignal   CompanySignal? @relation(fields: [companySignalId], references: [id], onDelete: SetNull)
  name            String?
  role            String?
  email           String?
  phone           String?
  source          String
  sourcePolicy    String?
  confidence      Float    @default(0.5)
  createdAt       DateTime @default(now())

  @@index([opportunityId])
  @@index([companySignalId])
}

model OutreachActivity {
  id              String   @id @default(cuid())
  opportunityId   String
  opportunity     Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  type            String   // email, call, meeting, proposal, other
  status          String   // planned, completed, cancelled
  notes           String?  @db.Text
  actor           String?  // user email or "system"
  createdAt       DateTime @default(now())

  @@index([opportunityId])
}