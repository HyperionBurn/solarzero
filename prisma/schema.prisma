generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Building {
  id           String       @id @default(cuid())
  osmId        String?
  osmType      String?
  address      String
  lat          Float
  lng          Float
  roofAreaM2   Float?
  buildingType String?
  heightMeters Float?
  hasSolar     Boolean      @default(false)
  assessment   Assessment?
  proposals    Proposal[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([lat, lng])
  @@index([buildingType])
  @@index([osmId])
}

model Assessment {
  id               String     @id @default(cuid())
  buildingId       String     @unique
  building         Building   @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  dataSource       String     @default("HYBRID")
  ghiAnnual        Float
  systemSizeKwp    Float
  panelCount       Int
  annualProduction Float
  totalCostAed     Float
  annualSavingsAed Float
  paybackYears     Float
  npv25yrAed       Float
  co2OffsetTons    Float
  dewaTariffAed    Float      @default(0.32)
  rawResponseJson  Json?
  proposals        Proposal[]
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  role         String    @default("user")
  emailVerified DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  accounts  Account[]
  sessions  Session[]
  verificationTokens VerificationToken[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Proposal {
  id           String     @id @default(cuid())
  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  buildingId   String
  building     Building   @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  pdfUrl       String?
  status       String     @default("pending")
  generatedBy  String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}