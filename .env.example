# Copy to .env.local and fill in your values. Do NOT commit .env.local.

# ===== Database (Supabase PostgreSQL) =====
# Format: postgresql://postgres:[YOUR-PASSWORD]@[YOUR-HOST]:5432/postgres
DATABASE_URL="postgresql://postgres:password@localhost:5432/solarzero"
DIRECT_URL="postgresql://postgres:password@localhost:5432/solarzero"

# ===== Authentication (NextAuth.js) =====
# Generate with: openssl rand -base64 32 (or use https://generate-secret.vercel.app/32)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me-to-a-random-32-char-string"

# ===== Mapbox =====
# Get from https://account.mapbox.com/access-tokens/
NEXT_PUBLIC_MAPBOX_TOKEN="pk.eyJ1IjoieW91ci1hY2NvdW50IiwiYSI6ImNscHh4eHh4eDAwMDAyanBnNnFzOHh4eHgifQ.xxxxx"

# ===== Solcast API (Solar Irradiance) =====
# Get from https://toolkit.solcast.com.au/ (free tier: ~10 req/day)
# MVP works without this — custom UAE model is primary source
SOLCAST_API_KEY="your-solcast-api-key-here"

# ===== OpenStreetMap Overpass API =====
# Public API, no key needed. Change if using a private instance.
OVERPASS_API_URL="https://overpass-api.de/api/interpreter"

# ===== Redis (Upstash) =====
# Get from https://console.upstash.com/ (free tier available)
# Used for: rate limiting, assessment caching, BullMQ job queue
UPSTASH_REDIS_URL="redis://default:your-token@your-endpoint.upstash.io:6379"
UPSTASH_REDIS_TOKEN="your-upstash-token"

# ===== Cloudflare R2 (PDF Storage) =====
# Get from https://dash.cloudflare.com/ → R2 → Create Bucket
CLOUDFLARE_R2_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
CLOUDFLARE_R2_ACCESS_KEY_ID="your-r2-access-key-id"
CLOUDFLARE_R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
CLOUDFLARE_R2_BUCKET="solarzero-proposals"
CLOUDFLARE_R2_PUBLIC_URL="https://pub-<hash>.r2.dev"

# ===== Email (SMTP / Resend) =====
# Get from https://resend.com/ (free tier: 100 emails/day)
SMTP_HOST="smtp.resend.com"
SMTP_PORT=587
SMTP_USER="resend"
SMTP_PASSWORD="your-resend-api-key"
EMAIL_FROM="SolarZero <noreply@solarzero.app>"
RESEND_API_KEY="your-resend-api-key"

# ===== App Configuration =====
NEXT_PUBLIC_APP_NAME="SolarZero"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
